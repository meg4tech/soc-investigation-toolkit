# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Data - only synthetic sample data may be committed.
# Data exports are ignored anywhere in the repo, so a real sign-in log saved
# in the wrong folder cannot be committed by accident.
*.csv
*.tsv
*.xls
*.xlsx
*.json
!config/*.json
*.evtx
*.log
data/*
!data/sample/
data/sample/*
!data/sample/README.md
!data/sample/synthetic_*.csv

# Secrets - never commit credentials, keys or tokens.
# Kept after the data rules: Git applies the last matching rule, so these
# still win over the !config/*.json exception above.
.env
.env.*
*.pem
*.key
*.pfx
*.p12
secrets.*
*secret*.json
credentials*.json

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Claude Code local settings
.claude/settings.local.json
